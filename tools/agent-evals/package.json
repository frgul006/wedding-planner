{
  "name": "@wedding-planner/agent-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "node --import tsx -- src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src test",
