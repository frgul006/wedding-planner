    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pi": "./src/adapters/pi-runner.ts",
    "./jev": "./src/adapters/jev-judge.ts",
    "./files": "./src/adapters/library-file-store.ts",
    "./examples/diagnosis": "./src/examples/diagnosis.ts"
