{
  "name": "wedding-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && pnpm lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --quiet --ignore-pattern 'tools/agent-evals/**' --ignore-pattern 'evals/**' .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "seed:local": "node scripts/seed-local.mjs",
    "bootstrap:production": "node scripts/bootstrap-production.mjs",
    "guest:reset-invite": "node scripts/reset-production-guest-invite-state.mjs",
    "sms:test": "node scripts/send-elk46-test.mjs",
    "evals": "pnpm --silent --filter @wedding-planner/agent-evals cli",
    "test:evals": "pnpm --filter @wedding-planner/agent-evals test",
    "check:evals": "pnpm --filter @wedding-planner/agent-evals check",
    "format:evals": "pnpm --filter @wedding-planner/agent-evals format"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
