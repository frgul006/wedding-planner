{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["node_modules/**", "coverage/**"]
}
